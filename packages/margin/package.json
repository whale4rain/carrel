{
  "name": "@carrel/margin",
  "version": "0.0.0",
  "private": true,
  "description": "Margin design system in code: tokens to CSS, components.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./margin.css": "./src/margin.css",
    "./tokens.css": "./src/generated/tokens.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "tokens": "node --experimental-strip-types --no-warnings scripts/build-tokens.ts"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/literata": "5.3.0"
  }
}
